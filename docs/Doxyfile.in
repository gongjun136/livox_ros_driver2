PROJECT_NAME           = "Livox ROS Driver 2 Core"
PROJECT_BRIEF          = "部署与开发手册：工作区、采集链路、接口、授时与排障"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIRECTORY@"
OUTPUT_LANGUAGE        = Chinese
INPUT                  = "@LIVOX_SOURCE_DIR@/docs" "@LIVOX_SOURCE_DIR@/src"
FILE_PATTERNS          = *.md *.dox *.h *.hpp *.cpp
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = "@LIVOX_SOURCE_DIR@/docs/index.md"
EXAMPLE_PATH           = "@LIVOX_SOURCE_DIR@/scripts" "@LIVOX_SOURCE_DIR@/launch_ROS2" "@LIVOX_SOURCE_DIR@/config"
EXAMPLE_PATTERNS       = *.sh *.py *.json *.yaml
EXAMPLE_RECURSIVE      = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@LIVOX_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@LIVOX_SOURCE_DIR@/src"
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
ENABLE_PREPROCESSING   = YES
PREDEFINED             = BUILDING_ROS2
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
COLLABORATION_GRAPH    = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 60
MAX_DOT_GRAPH_DEPTH    = 3
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@CMAKE_CURRENT_BINARY_DIR@/doxygen-warnings.log"
